# Neon Postgres (member edits, comments, merge sync)
DATABASE_URL=

# Auth.js + GitHub OAuth App
# Callback: https://<host>/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_URL=https://shiplog-snowy.vercel.app

# Optional: higher GitHub API rate limits for /api/sync
GITHUB_TOKEN=

# Optional: require Authorization: Bearer <secret> on /api/sync
SYNC_SECRET=

# Optional: HMAC for POST /api/webhooks/github
GITHUB_WEBHOOK_SECRET=

# Screenshot uploads (Vercel Blob); uploads are resized to WebP
BLOB_READ_WRITE_TOKEN=

# Optional override (default cohort@hult.edu)
# PLACEMENT_LEAD_EMAIL=cohort@hult.edu
