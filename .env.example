# Neon Postgres (required for member edits, comments, merge sync)
DATABASE_URL=

# Auth.js + GitHub OAuth (https://github.com/settings/developers)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_URL=https://shiplog-snowy.vercel.app

# Optional: raise GitHub API rate limits for sync
GITHUB_TOKEN=

# Optional: protect POST /api/sync (cron + manual)
SYNC_SECRET=

# Optional: GitHub webhook signature for /api/webhooks/github
GITHUB_WEBHOOK_SECRET=

# Optional: screenshot uploads via Vercel Blob
BLOB_READ_WRITE_TOKEN=

